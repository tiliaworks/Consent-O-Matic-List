{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "dpgmedia": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#pg-modal"
            },
            "parent": {
              "selector": "#pg-shadow-host-dom"
            }
          }
        ],
        "showingMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#pg-modal"
            },
            "parent": {
              "selector": "#pg-shadow-host-dom"
            }
          }
        ]
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": "#pg-configure-btn"
          },
          "parent": {
            "selector": "#pg-shadow-host-dom"
          }
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#pg-reject-btn"
          },
          "parent": {
            "selector": "#pg-shadow-host-dom"
          }
        }
      }
    ]
  }
}
