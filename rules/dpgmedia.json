{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "dpgmedia": {
    "domains": [
      "myprivacy.dpgmedia.nl",
      "myprivacy.dpgmedia.be",
      "www.dpgmediagroup.com",
      "myprivacy.dpgmediagroup.net"
    ],
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#pg-shadow-host-dom"
            }
          }
        ],
        "showingMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#pg-first-layer"
            },
            "parent": {
              "selector": "#pg-shadow-host-dom"
            }
          }
        ]
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": "button#pg-configure-btn"
          },
          "parent": {
            "selector": "#pg-shadow-host-dom"
          }
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "button#pg-reject-btn"
          },
          "parent": {
            "selector": "#pg-shadow-host-dom"
          }
        }
      }
    ]
  }
}
