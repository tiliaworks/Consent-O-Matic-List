{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "dpgmedia": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#pg-modal"
            },
            "parent": {
              "selector": "#pg-host-shadow-root"
            }
          }
        ],
        "showingMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#pg-modal"
            },
            "parent": {
              "selector": "#pg-host-shadow-root"
            }
          }
        ]
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": "button#pg-configure-btn"
          },
          "parent": {
            "selector": "#pg-host-shadow-root"
          }
        }
      },
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "list",
          "list": [
            {
              "type": "uncheck",
              "target": {
                "selector": "input[type='checkbox']"
              },
              "parent": {
                "selector": "#pg-host-shadow-root"
              }
            }
          ]
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "button#pg-save-preferences-btn"
          },
          "parent": {
            "selector": "#pg-host-shadow-root"
          }
        }
      }
    ]
  }
}
