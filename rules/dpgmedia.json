{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "dpgmedia": {
    "domains": [
      "myprivacy.dpgmedia.nl",
      "myprivacy.dpgmedia.be",
      "www.dpgmediagroup.com",
      "myprivacy.dpgmediagroup.net"
    ],
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#pg-host-shadow-root"
            }
          }
        ],
        "showingMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#pg-host-shadow-root"
            }
          }
        ]
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": "button#pg-configure-btn"
          },
          "parent": {
            "selector": "#pg-host-shadow-root"
          }
        }
      },
      {
        "name": "DO_CONSENT",
        "consents": [
          {
            "type": "checkbox",
            "target": {
              "selector": "[id^='purpose-row-'] input[type='checkbox']"
            },
            "parent": {
              "selector": "#pg-host-shadow-root"
            },
            "value": false
          }
        ]
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "button#pg-save-preferences-btn"
          },
          "parent": {
            "selector": "#pg-host-shadow-root"
          }
        }
      }
    ]
  }
}
